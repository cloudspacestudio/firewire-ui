  "scripts": {
    "generate:about": "node scripts/generate-about-metadata.cjs",
    "generate:videos": "node scripts/generate-video-manifest.cjs",
    "ng": "ng",
    "prestart": "npm run generate:about && npm run generate:videos",
    "start": "ng serve",
    "prebuild": "npm run generate:about && npm run generate:videos",
    "build": "ng build",
    "prewatch": "npm run generate:about && npm run generate:videos",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generate:about && npm run generate:videos",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.8",
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
